@namespace FluentUI.Blazor.Monaco.EditorPack.Shared.Components.Controls
@inherits FluentDialogInstance

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
        <FluentSelect TOption="string"
                      TValue="string"
                      Label="Theme"
                      Width="100%"
                      Items="@AllModes"
                      Value="@Mode"
                      ValueChanged="@OnModeChangedAsync" />

        <FluentSelect TOption="string"
                      TValue="string"
                      Label="Color"
                      Width="100%"
                      Items="@AllColors"
                      Value="@ColorName"
                      ValueChanged="@OnColorChangedAsync" />

        <FluentDivider Style="width: 100%; margin: 1rem 0" />

        <p>
            This site stores settings for the theme and color and downloaded samples in the browser's cache and local storage.
            Use the button below to clear them and reset to the system theme.
        </p>

        <FluentButton Style="width: 125px;" OnClick="@ResetSiteAsync">Reset settings</FluentButton>

        <p style="margin-top: 1rem;">
            <em><strong>@_status</strong></em>
        </p>
    </FluentStack>
</FluentDialogBody>
