<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- Package Metadata -->
    <PackageId>FluentUI.Blazor.Monaco.EditorPack</PackageId>
    <Version>1.1.0</Version>
    <Authors>Michael Gerfen</Authors>
    <Company>Evolution Software Design, Inc.</Company>
    <Description>Monaco-based Markdown and CSS editors for Blazor with FluentUI integration. Includes IntelliSense, syntax highlighting, and theme support.</Description>
    <PackageTags>blazor;monaco;editor;markdown;css;fluentui;intellisense</PackageTags>
    <PackageProjectUrl>https://github.com/gerfen/FluentUI.Blazor.Monaco.EditorPack</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gerfen/FluentUI.Blazor.Monaco.EditorPack</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Copyright -->
    <Copyright>Copyright © 2026 Michael Gerfen</Copyright>

    <!-- Release Notes -->
    <PackageReleaseNotes>1.1.0: Fixes Monaco web worker load errors when the app is hosted at the site root. Security: the default sanitizer now strips raw style and iframe elements from the Markdown preview; opt back in with AddMonacoEditorPack(o => { o.AllowStyleTags = true; o.AllowIframes = true; }). 1.0.0: First stable release. Requires Microsoft.FluentUI.AspNetCore.Components v5. Breaking change from 0.x (Fluent UI v4); see UPGRADE_GUIDE_FLUENTUI_V5.md in the repository.</PackageReleaseNotes>

    
    <!-- Enable static web assets -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetBasePath>_content/FluentUI.Blazor.Monaco.EditorPack</StaticWebAssetBasePath>
    <PackageIcon>simple-logo-256x256.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Include root README.md in package -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\simple-logo-256x256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Markdig" Version="0.44.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.20" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="HtmlSanitizer" Version="9.0.892" />
		<PackageReference Include="Markdig" Version="0.44.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="5.0.0" />
		<PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="5.0.0" />
	</ItemGroup>

</Project>
